# Makefile for the Paravel Ubuntu 22.04 repo

#SHELL := /bin/bash

sign:	clean sane
	gpgconf --kill gpg-agent
	apt-ftparchive --arch amd64 packages binary-amd64 > Packages
	gzip -k -f Packages
	apt-ftparchive release . > Release
	gpg --default-key "$(REPO_KEY)" -abs -o Release.gpg Release
	gpg --default-key "$(REPO_KEY)" --clearsign -o InRelease Release
	gpg --export "$(REPO_KEY)" > $(REPO_NAME).gpg

post:	sane
	rsync -rptgoDv --copy-links --delete --exclude Makefile --exclude sanity_check.sh --exclude *.tar.gz . $(REPO_RSYNC_TARGET)/

local:	sane
	rsync -rptgoDv --copy-links --delete --exclude Makefile --exclude sanity_check.sh --exclude *.tar.gz . ../../../locals/jammy/main/
	tar -C ../../../locals/jammy/main/ --exclude Makefile --exclude sanity_check.sh --exclude *.tar.gz -zvcf repo-jammy-2204.tar.gz *

sane:	
	./sanity_check.sh  

clean:
	rm -f Packages*
	rm -f Release*
	rm -f InRelease*
	rm -f *.gpg
	rm -f *.tar.gz

